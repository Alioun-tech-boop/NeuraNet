# NEURANET - Environment Configuration Example
# Per ARCHITECTURE-ESSENTIALS §69: Never commit secrets. Use environment variables.
# Copy this file to .env and fill in actual values.

# ============================================================
# Database
# ============================================================
# Local development:
DATABASE_URL=postgresql://neuranet:neuranet_password@localhost:5432/neuranet
# Supabase (Supavisor pooler, IPv4 - use this for hosted projects):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# Direct Supabase host is IPv6-only: db.<project-ref>.supabase.co (requires IPv6)

# ============================================================
# Server
# ============================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ============================================================
# Authentication
# ============================================================
API_KEY_NAME=X-API-Key
JWT_SECRET=your-jwt-secret-key-change-in-production

# ============================================================
# NeuraNet API (Agent-facing)
# ============================================================
NEURANET_API_KEY=your-neuranet-api-key-here
NEURANET_API_BASE_URL=http://localhost:3000
DEFAULT_ORGANIZATION_ID=org-default

# ============================================================
# LLM Providers (Agents)
# ============================================================
# Agent A (Researcher) - Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_INPUT_PRICE_PER_1K=0.015
ANTHROPIC_OUTPUT_PRICE_PER_1K=0.075

# Agent B (Independent Researcher) - GPT
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_PRICE_PER_1K=0.005
OPENAI_OUTPUT_PRICE_PER_1K=0.015

# Agent C (Collective Researcher) - Gemini
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-flash-latest
GEMINI_INPUT_PRICE_PER_1K=0.0025
GEMINI_OUTPUT_PRICE_PER_1K=0.0075

# Groq (Agent B)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_INPUT_PRICE_PER_1K=0.0001
GROQ_OUTPUT_PRICE_PER_1K=0.0001

# OpenRouter (Agent C collective)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_INPUT_PRICE_PER_1K=0.0001
OPENROUTER_OUTPUT_PRICE_PER_1K=0.0001

# ============================================================
# Search Provider
# ============================================================
# Web search provider configuration
SEARCH_PROVIDER_TYPE=websearch  # websearch, tavily, firecrawl
# Optional: Tavily API key for higher quality search (otherwise uses Wikipedia + DuckDuckGo, no key required)
# TAVILY_API_KEY=your-tavily-api-key

# ============================================================
# Experiment & Benchmark
# ============================================================
EXPERIMENT_TASK=Analyze the market for electric vehicles in Ghana
BENCHMARK_MODE=neuranet  # baseline or neuranet

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=info